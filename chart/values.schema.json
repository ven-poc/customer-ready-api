{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["image", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "tag": { "type": "string", "not": { "enum": ["latest"] } }
      }
    },
    "resources": {
      "type": "object",
      "required": ["limits"],
      "properties": {
        "limits": {
          "type": "object",
          "required": ["memory", "cpu"]
        }
      }
    }
  }
}
